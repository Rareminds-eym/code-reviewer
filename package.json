{
	"name": "code-reviewer",
	"version": "1.0.0",
	"description": "AI-powered GitHub PR reviewer using Cloudflare Workers + Queues with Claude/Gemini LLMs",
	"private": true,
	"scripts": {
		"deploy": "DOCKER_API_VERSION=1.44 wrangler deploy",
		"dev": "DOCKER_API_VERSION=1.44 wrangler dev",
		"start": "DOCKER_API_VERSION=1.44 wrangler dev",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"usage-report": "tsx scripts/usage-client.ts",
		"build:container": "npm run build --prefix container"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.4",
		"@types/node": "^25.5.0",
		"@vitest/coverage-v8": "^3.2.4",
		"fast-check": "^3.23.2",
		"tsx": "^4.19.2",
		"typescript": "^5.5.2",
		"vitest": "~3.2.0",
		"wrangler": "^4.74.0"
	},
	"dependencies": {
		"@cloudflare/containers": "^0.3.2",
		"@opentelemetry/api": "^1.9.1"
	}
}
