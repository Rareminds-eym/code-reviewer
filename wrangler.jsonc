/**
 * Wrangler configuration for the Code Reviewer Agent.
 * Secrets (API keys, tokens) are set via: npx wrangler secret put <KEY>
 * See README.md for the full setup guide.
 *
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "code-reviewer",
	"account_id": "ad91abcd16cd9e9c569d83d9ef46e398",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	/**
	 * Non-secret environment variables.
	 * Override at deploy time: npx wrangler deploy --var AI_PROVIDER:gemini
	 *
	 * AI_PROVIDER: "claude" (default) | "gemini"
	 */
	"vars": {
		"AI_PROVIDER": "claude",
		"ALLOWED_TARGET_BRANCHES": "dev",
		"CLIQ_BOT_NAME": "codereviewbot",
		"CLIQ_CHANNEL_ID": "prweb",
		"CLIQ_DB_NAME": "githubusermap",
		"ENABLE_WEB_SEARCH": "true"
	},
	/**
	 * Queues
	 * Connects the fast webhook handler to the long-running LLM worker
	 */
	"queues": {
		"producers": [
			{
				"binding": "REVIEW_QUEUE",
				"queue": "code-reviewer-queue"
			}
		],
		"consumers": [
			{
				"queue": "code-reviewer-queue",
				"max_batch_size": 1,
				"max_concurrency": 2,
				"max_retries": 2
			}
		]
	},
	/**
	 * KV Namespaces — isolated by concern to prevent TTL conflicts and key collisions.
	 * Create with:
	 *   npx wrangler kv:namespace create USAGE_METRICS
	 *   npx wrangler kv:namespace create AUTH_KV
	 *   npx wrangler kv:namespace create CACHE_KV
	 *   npx wrangler kv:namespace create DEDUP_KV
	 */
	"kv_namespaces": [
		{
			"binding": "USAGE_METRICS",
			"id": "2825e1ef509f4069b316c5e96d1dd61b"
		},
		{
			"binding": "AUTH_KV",
			"id": "c715f1033e3c4d2d8fcc356a62657390"
		},
		{
			"binding": "CACHE_KV",
			"id": "800a1d0290dd4b8091dc919f48ebc1e5"
		},
		{
			"binding": "DEDUP_KV",
			"id": "84049d8f2396421682c8abe889dd1ffe"
		}
	],
	/**
	 * Containers — Ephemeral Docker containers for heavy review compute.
	 * The ReviewContainer class (src/container-class.ts) manages lifecycle.
	 * The Docker image (container/Dockerfile) runs the actual review pipeline.
	 */
	"containers": [
		{
			"class_name": "ReviewContainer",
			"image": "./container/Dockerfile",
			"instance_type": "standard-2",
			"max_instances": 10
		}
	],
	/**
	 * Durable Object binding for the ReviewContainer.
	 * The Worker uses this to dispatch review jobs to container instances.
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "REVIEW_CONTAINER",
				"class_name": "ReviewContainer"
			}
		]
	},
	/**
	 * DO migration — required for first deploy.
	 * Uses SQLite-backed DOs as required by Cloudflare Containers.
	 */
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ReviewContainer"]
		},
		{
			"tag": "v2",
			"new_classes": ["RateLimiterDO"]
		},
		{
			"tag": "v3",
			"deleted_classes": ["RateLimiterDO"]
		}
	],
	/**
	 * Multi-Environment Configuration
	 * Deploy using: npx wrangler deploy --env dev
	 * Remember to create bindings and set secrets for the dev environment.
	 */
	"env": {
		"dev": {
			"name": "code-reviewer-dev",
			"vars": {
				"AI_PROVIDER": "claude",
				"ALLOWED_TARGET_BRANCHES": "dev",
				"CLIQ_BOT_NAME": "codereviewbot-dev",
				"CLIQ_CHANNEL_ID": "prweb-dev",
				"CLIQ_DB_NAME": "githubusermap-dev",
				"ENABLE_WEB_SEARCH": "true"
			},
			"queues": {
				"producers": [
					{
						"binding": "REVIEW_QUEUE",
						"queue": "code-reviewer-queue-dev"
					}
				],
				"consumers": [
					{
						"queue": "code-reviewer-queue-dev",
						"max_batch_size": 1,
						"max_concurrency": 2,
						"max_retries": 2
					}
				]
			},
			"kv_namespaces": [
				{
					"binding": "USAGE_METRICS",
					"id": "1698dbe950604758b2ed4839bcd56a5e"
				},
				{
					"binding": "AUTH_KV",
					"id": "f976db7cdf154dcb89082bdf993f26f5"
				},
				{
					"binding": "CACHE_KV",
					"id": "0533a77b4a3841e7beb5ced6e7d5a42f"
				},
				{
					"binding": "DEDUP_KV",
					"id": "42b79bc174c04323bde728942c0cf200"
				}
			],
			"containers": [
				{
					"class_name": "ReviewContainer",
					"image": "./container/Dockerfile",
					"instance_type": "standard-2",
					"max_instances": 3
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "REVIEW_CONTAINER",
						"class_name": "ReviewContainer"
					}
				]
			}
		}
	}
}